# 103.5  -- fever or Temp: 98 F
\b\d{2,3}(\.\d+)?\b
\b\d{2,3}('?s)?\b

# 130/100  -- blood pressure
(?<=\D)\d\d\d? {0,2}\/ {0,2}\d\d\d?(?=\D)
\b\d{2,3}( *'?s)? {0,2}(/|over) {0,2}\d{2,3}( *'?s)?


# Get this:      BP-130/76 (90-130s/40s-70s)
# but not:       VS-98.6-118/61-102-20.
# and not this:  Vital Signs:  100.8F-30-122-129/75-93% SaO2 on 2L/min, CVP 10


(?<!\-)\b(\d{2,3}( *'?s)? ?- ?)?\d{2,3}( *'?s)? {0,2}(/|over) {0,2}(\d{2,3}( *'?s)? ?- ?)?\d{2,3}( *'?s)?

\b\d{2,3}-\d{2,3} {0,2}s?\/ {0,2}\d{2,3}-\d{2,3}s?\b

(?<=\D)\d{2,3} ?\+\/- ?\d+


# P119 R18
(?<=[rptb])\d{2,3}\b

(?<=t)\d{2,3}\.\d+\b

\b\d{2,3}\.\d+(?=f\b)
\b\d{2,3}\.\d+(?=c\b)

\b\d{2,3}\s*over\s*\d{2,3}\b