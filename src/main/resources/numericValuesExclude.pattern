
<gov.va.vinci.vitals.types.Timestamp/>

# (801) 647-9999
\( ?\d+ ?\) ?((\d+|\-|\*) ?)+

# single digit number is ok for pain. Will have to reconsider when pain is included in the extraction
#[^\.]\b\d\b

# 09/09/1990
\b\d+/\d+/\d+\b
\b\d+:\d+:\d+\b

# 09-09-09
# \b\d+-\d+-\d+\b 

\w+ *'\d\d\b
\n *\d+\. 
\n *\d+\)


<gov.va.vinci.vitals.types.Numeric/> *-? *y\w*
<gov.va.vinci.vitals.types.Numeric/> *IV
<gov.va.vinci.vitals.types.Numeric/> *(mcg|mg|spray|lpm|cc|units|minutes?|sec(onds?)?)
(reading|#|CVP|MAP|i.o|MOFH)\s*<gov.va.vinci.vitals.types.Numeric/>
(jan\w*|feb\w*|mar\w*|apr\w*|may\w*|jun\w*|jul\w*|aug\w*|sep\w*|oct\w*|nov\w*|dec\w*) +<gov.va.vinci.vitals.types.Numeric/>

\b\d/\d+\b
